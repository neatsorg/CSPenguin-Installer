--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -444,6 +444,26 @@
     /* child windows are not managed */
     style = NtUserGetWindowLongW( hwnd, GWL_STYLE );
     if ((style & (WS_CHILD|WS_POPUP)) == WS_CHILD) return FALSE;
+    /* CSPenguin: owned borderless popups (menus, tooltips, dropdowns) are not managed,
+     * even when activated. Some window managers (e.g. COSMIC) re-place managed
+     * transient windows and ignore the requested position, which makes menus
+     * appear far away from where they were opened. */
+    if (!fullscreen && (style & WS_POPUP) && (style & WS_CAPTION) != WS_CAPTION &&
+        !(style & (WS_THICKFRAME | WS_SYSMENU)) && NtUserGetWindowRelative( hwnd, GW_OWNER ))
+    {
+        static int enabled = -1;
+        if (enabled == -1)
+        {
+            const char *env = getenv( "CSPENGUIN_MANAGED_POPUPS" );
+            enabled = !(env && *env == '1');
+        }
+        ex_style = NtUserGetWindowLongW( hwnd, GWL_EXSTYLE );
+        if (enabled && !(ex_style & WS_EX_APPWINDOW))
+        {
+            TRACE( "%p: owned borderless popup, not managed\n", hwnd );
+            return FALSE;
+        }
+    }
     /* activated windows are managed */
     if (!(swp_flags & (SWP_NOACTIVATE|SWP_HIDEWINDOW))) return TRUE;
     if (hwnd == get_active_window()) return TRUE;
@@ -2422,7 +2442,9 @@
     if (data->vis.visualid != default_visual.visualid)
         data->whole_colormap = XCreateColormap( data->display, root_window, data->vis.visual, AllocNone );
 
-    data->managed = is_window_managed( data->hwnd, SWP_NOACTIVATE, FALSE );
+    /* CSPenguin: decide only once the window is shown, see X11DRV_WindowPosChanged */
+    data->managed = (NtUserGetWindowLongW( data->hwnd, GWL_STYLE ) & WS_VISIBLE) &&
+                    is_window_managed( data->hwnd, SWP_NOACTIVATE, FALSE );
     mask = get_window_attributes( data, &attr ) | CWOverrideRedirect;
     attr.override_redirect = !data->managed;
 
@@ -3255,7 +3277,12 @@
     struct window_rects old_rects;
     BOOL is_managed, was_fullscreen, activate = !(swp_flags & SWP_NOACTIVATE), fullscreen = !!(swp_flags & WINE_SWP_FULLSCREEN);
 
-    if ((is_managed = is_window_managed( hwnd, swp_flags, fullscreen ))) make_owner_managed( hwnd );
+    /* CSPenguin: a window can't be made unmanaged again, so only decide once it is shown.
+     * Windows created without WS_POPUP get WS_CAPTION on creation and would be managed
+     * for good, even when their style becomes a borderless popup before they are shown
+     * (comctl32 tooltips do that), and window managers such as COSMIC then place them. */
+    if ((is_managed = (new_style & WS_VISIBLE) && is_window_managed( hwnd, swp_flags, fullscreen )))
+        make_owner_managed( hwnd );
 
     if (!(data = get_win_data( hwnd ))) return;
     if (is_managed) window_set_managed( data, TRUE );
